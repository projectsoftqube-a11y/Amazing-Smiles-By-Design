# Appointment request form (src/lib/appointment.ts).
# Copy to .env.local (or add in Vercel > Settings > Environment Variables) and fill in.
# Until SMTP_HOST, SMTP_USER and SMTP_PASS are set, the form asks visitors to call or text.
# Never commit real values: .env* files are gitignored.

SMTP_HOST=
# 587 with STARTTLS (SMTP_SECURE=false), or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where requests are delivered (defaults to the practice email in site.ts)
FORM_TO_EMAIL=
# Sender address; defaults to SMTP_USER. Must be allowed by the SMTP provider.
FORM_FROM_EMAIL=
